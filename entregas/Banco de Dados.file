  CONSTRAINT `fk_Filho_Responsável`
    FOREIGN KEY (`Responsável_id_Responsavel`)
    REFERENCES `saep_db`.`responsável` (`id_Responsavel`))
ENGINE = InnoDB
DEFAULT CHARACTER SET = utf8mb3;

CREATE INDEX `fk_Filho_Responsável_idx` ON `saep_db`.`filho` (`Responsável_id_Responsavel` ASC) VISIBLE;

