CREATE TABLE IF NOT EXISTS `saep_db`.`filho` (
  `id_Filho` INT NOT NULL,
  `Nome` VARCHAR(100) NOT NULL,
  `Data_Nascimento` DATE NOT NULL,
  `Nivel_Natacao` ENUM('Iniciante', 'Intermediário', 'Avançado') NOT NULL,
  `Responsável_id_Responsavel` INT NOT NULL,
  `Aula_Agendada_id_Aula_Agendada` INT NOT NULL,
  PRIMARY KEY (`id_Filho`, `Responsável_id_Responsavel`, `Aula_Agendada_id_Aula_Agendada`),
  CONSTRAINT `fk_Filho_Aula_Agendada1`
